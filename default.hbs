    <script src="https://unpkg.com/sweetalert@2.1.2/dist/sweetalert.min.js"></script>
<script src="https://cdn.rohanmcdermott.com/assets/js/clipboard.js"></script>
    <script>
    var ip = "PLAY.WINTERCRESTMC.COM:25565";

    $(document).ready(function () {
    updateCount();

    });
    updateCount();

    function updateCount() {
        $.getJSON('https://eu.mc-api.net/v3/server/info/' + ip, function (jd) {
            if (jd.error) {
                $('.mc-count').html('0');
            } else {
                $('.mc-count').html(jd.players.online);
            }
        });
        setTimeout(updateCount, 59000);
    }

    new Clipboard('#mc-server', {
        text: function () {
            return ip;
        }
    });
    
    
    $("#mc-server").click(function () {
        swal({
            title: "You copied the server IP!",
            text: "We look forward to you joining us!",
            icon: "success",
            button: "Close",
            timer: 150000
        });
    });
</script>
<script>
    $.get('https://discordapp.com/api/guilds/265159280909352961/embed.json', function (e) {
        var playerCount = e['presence_count'];
        $('.discord-count').html(playerCount);
    });
</script>
