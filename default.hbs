<!DOCTYPE html>
<html lang="{{@site.locale}}" {{#match @custom.color_scheme "Dark"}} class="dark-mode"
    {{else match @custom.color_scheme "Auto"}} class="auto-color" {{/match}}>

<head>

    {{!-- Basic meta - advanced meta is output with {ghost_head} below --}}
    <title>{{meta_title}}</title>
    <meta charset="utf-8" />
    <meta http-equiv="X-UA-Compatible" content="IE=edge" />
    <meta name="HandheldFriendly" content="True" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    {{!-- Theme assets - use the {asset} helper to reference styles & scripts,
    this will take care of caching and cache-busting automatically --}}
    <link rel="stylesheet" type="text/css"
        href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.2.1/css/all.min.css" />
    <link
        href="https://fonts.googleapis.com/css2?family=Nunito:ital,wght@0,200;0,300;0,400;0,500;0,600;0,700;0,800;0,900;1,200;1,300;1,400;1,500;1,600;1,700;1,800;1,900&amp;display=swap"
        rel="stylesheet">
    <link rel="stylesheet" type="text/css" href="{{asset "built/screen.css"}}" />
    <link rel="stylesheet" type="text/css" href="{{asset "built/mcdermott.css"}}" />
    <link href="https://fonts.googleapis.com/css2?family=Rajdhani:wght@500;600;700&display=swap" rel="stylesheet">
    <style>
        .hdr-v5-hero {
            position: relative;
            height: 400px;
            {{#if @site.cover_image}}
            background-image: url({{img_url @site.cover_image size="xl"}});
            {{else}}
            background-image: url({{asset "img/bg.png"}});
            {{/if}}
            background-size: cover;
            background-position: center;
            overflow: hidden;
        }
        .hdr-v5-hero::before {
            content: "";
            position: absolute;
            inset: 0;
            background: linear-gradient(180deg, rgba(6,10,20,0.35) 0%, rgba(6,10,20,0.55) 60%, var(--dark1) 100%);
        }
        .hdr-v5-brand {
            position: relative;
            z-index: 2;
            text-align: center;
            padding-top: 40px;
        }
        .hdr-v5-logo-img {
            height: 220px;
            width: auto;
            max-width: 88%;
            margin: 0 auto;
            display: block;
            filter: drop-shadow(0 10px 26px rgba(0,0,0,0.5));
        }
        .hdr-v5-brand .word {
            font-family: 'Nunito', sans-serif;
            font-weight: 900;
            font-size: 3.4rem;
            letter-spacing: -0.02em;
            color: #fff;
            text-shadow: 0 4px 24px rgba(0,0,0,0.4);
            text-decoration: none;
        }
        .hdr-v5-brand .word span { color: var(--primary); }
        .hdr-v5-domain-row {
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 14px;
            margin-top: 14px;
        }
        .hdr-v5-domain-row svg {
            flex-shrink: 0;
            opacity: .85;
        }
        .hdr-v5-domain {
            display: inline-block;
            font-family: 'Rajdhani', 'Nunito', sans-serif;
            font-weight: 700;
            font-size: 2.3rem;
            letter-spacing: 0.16em;
            text-transform: uppercase;
            text-decoration: none;
            background: linear-gradient(180deg, #ffffff 0%, var(--primary) 100%);
            -webkit-background-clip: text;
            background-clip: text;
            color: transparent;
            text-shadow: 0 2px 18px rgba(147,203,252,0.5);
            line-height: 1;
        }
        .hdr-v5-stat {
            position: absolute;
            top: 32px;
            z-index: 2;
            display: flex;
            align-items: center;
            gap: 12px;
            text-decoration: none;
            background: rgba(255,255,255,0.07);
            border: 1px solid rgba(255,255,255,0.12);
            backdrop-filter: blur(10px);
            -webkit-backdrop-filter: blur(10px);
            border-radius: 50px;
            padding: 8px 16px 8px 8px;
            box-shadow: 0 8px 22px rgba(0,0,0,0.25);
        }
        .hdr-v5-stat.left { left: 40px; }
        .hdr-v5-stat.right { right: 40px; flex-direction: row-reverse; padding: 8px 8px 8px 16px; }
        .hdr-v5-stat-ico {
            position: relative;
            width: 44px; height: 44px;
            border-radius: 50%;
            display: flex; align-items: center; justify-content: center;
            font-size: 1.5rem;
            color: #fff;
            flex-shrink: 0;
            box-shadow: 0 6px 14px rgba(0,0,0,0.3);
        }
        .hdr-v5-stat.left .hdr-v5-stat-ico { background: var(--secondary); }
        .hdr-v5-stat.right .hdr-v5-stat-ico { background: #5865F2; }
        .hdr-v5-stat-badge {
            position: absolute;
            top: -9px; right: -7px;
            background: var(--primary);
            color: #0d1626;
            font-weight: 900;
            font-size: 1.05rem;
            padding: 2px 7px;
            border-radius: 50px;
            border: 2px solid var(--dark1);
        }
        .hdr-v5-stat.right .hdr-v5-stat-badge { right: auto; left: -7px; }
        .hdr-v5-stat-text .platform {
            font-family: 'Rajdhani', 'Nunito', sans-serif;
            color: var(--primary);
            font-weight: 700;
            font-size: 1.3rem;
            letter-spacing: 0.02em;
        }
        .hdr-v5-stat.right .hdr-v5-stat-text { text-align: right; }
        .hdr-v5-stat-text .sub {
            color: rgba(255,255,255,0.6);
            font-weight: 700;
            font-size: 0.95rem;
            text-transform: uppercase;
            letter-spacing: 0.03em;
        }
        .hdr-v5-nav {
            position: relative;
            z-index: 2;
            background: var(--dark1);
            border-top: 1px solid rgba(255,255,255,0.06);
            box-shadow: 0 12px 20px -10px rgba(0,0,0,0.5);
        }
        .hdr-v5-nav-inner {
            max-width: 1200px;
            margin: 0 auto;
            display: flex;
            align-items: center;
            justify-content: space-between;
            padding: 0 40px;
        }
        .hdr-v5-links { display: flex; }
        .hdr-v5-links a {
            display: flex;
            flex-direction: row;
            align-items: center;
            gap: 9px;
            color: rgba(255,255,255,0.55);
            text-decoration: none;
            font-family: 'Rajdhani', 'Nunito', sans-serif;
            font-weight: 700;
            font-size: 1.5rem;
            letter-spacing: 0.03em;
            padding: 22px 20px;
            border-bottom: 3px solid transparent;
        }
        .hdr-v5-links a svg { flex-shrink: 0; }
        .hdr-v5-links a.active { color: var(--primary); border-color: var(--primary); }
        .hdr-v5-store {
            background: var(--secondary);
            color: #fff;
            font-family: 'Rajdhani', 'Nunito', sans-serif;
            font-weight: 700;
            font-size: 1.45rem;
            letter-spacing: 0.02em;
            padding: 12px 22px;
            border-radius: 10px;
            text-decoration: none;
            display: flex;
            align-items: center;
            gap: 8px;
        }
        @media (max-width: 900px) {
            .hdr-v5-stat.left, .hdr-v5-stat.right { position: static; margin: 10px auto 0; justify-content: center; }
            .hdr-v5-links a span.lbl { display: none; }
        }
    </style>





