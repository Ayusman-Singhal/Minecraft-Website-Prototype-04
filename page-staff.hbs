{{!< default}}

{{!-- Staff page. This template renders automatically for any Ghost page
whose slug is "staff" (Pages -> New page -> slug: staff). --}}

{{!-- ============================================================
     HOW TO ADD / EDIT / REMOVE STAFF (no Ghost accounts needed)
     ------------------------------------------------------------
     Everyone on this page comes from a single Markdown TABLE you
     write directly in this Page's content in Ghost's editor. There
     are no author accounts and no published-post requirement - just
     edit this one page whenever staff changes.

     In Ghost's editor, add a Markdown card with a table like this:

         | Name | Rank | Bio |
         |---|---|---|
         | Notch | Owner | Founder of the server. |
         | Jeb | Admin | Keeps everything running. |

       - Name  -> their in-game Minecraft username. Also used to
                  auto-generate their avatar from their skin (via
                  https://mc-heads.net) unless you add a 4th column.
       - Rank  -> must be one of: Owner, Lead, Dev, Admin, Mods,
                  Helpers, Trainees, Builders (case-insensitive).
       - Bio   -> short blurb shown on their card. Leave the cell
                  empty if you don't have one yet.
       - Avatar (optional 4th column) -> a direct image URL if you'd
                  rather use a custom picture instead of the
                  auto-generated skin render.

     You can also write any other content on this page as normal
     (an intro paragraph, images, etc.) - the table is simply found
     and read wherever it appears in the page.
     ============================================================ --}}

<main id="site-main" class="site-main outer">
    <div class="inner staff-page">

        <aside class="staff-apply">
            <h2><i class="fa-solid fa-pen-to-square"></i> Staff Application</h2>
            <p>Ready to be part of the Staff Team? Take the next step and send in your application here to showcase your skills and potential!</p>
            <a class="staff-apply-btn" href="https://discord.gg/wintercrest" target="_blank" rel="noopener">Apply Now</a>
        </aside>

        <section class="staff-team">
            <h2 class="staff-team-title">Our Staff Team</h2>

            <div class="staff-filters">
                <button class="staff-pill is-active" data-filter="owner">Owner</button>
                <button class="staff-pill" data-filter="lead">Lead</button>
                <button class="staff-pill" data-filter="dev">Dev</button>
                <button class="staff-pill" data-filter="admin">Admin</button>
                <button class="staff-pill" data-filter="mods">Mods</button>
                <button class="staff-pill" data-filter="helpers">Helpers</button>
                <button class="staff-pill" data-filter="trainees">Trainees</button>
                <button class="staff-pill" data-filter="builders">Builders</button>
            </div>

            <div class="staff-grid" id="staff-grid"></div>

            <p class="staff-empty" data-state="no-table" style="display:none;">No staff table found on this page yet. Add a Markdown table (Name / Rank / Bio) to the Staff page content in Ghost.</p>
            <p class="staff-empty" data-state="no-match" style="display:none;">No staff found for this rank yet.</p>
        </section>

        {{!-- The page's own written content (incl. the staff Markdown table) renders here,
             hidden from view - the script below reads the table out of it and builds the
             cards above. Any other text/images you write on the page stay hidden too, so
             keep the table as the only thing on this page (or accept that other content
             won't be visible). --}}
        <div id="staff-source" style="display:none">{{#post}}{{content}}{{/post}}</div>

    </div>
</main>

<script>
    (function () {
        var KNOWN_RANKS = ['owner', 'lead', 'dev', 'admin', 'mods', 'helpers', 'trainees', 'builders'];

        function parseStaffTable() {
            var table = document.querySelector('#staff-source table');
            if (!table) return [];

            var rows = table.querySelectorAll('tbody tr');
            var staff = [];
            rows.forEach(function (row) {
                var cells = row.querySelectorAll('td');
                if (cells.length < 2) return;
                var name = (cells[0].textContent || '').trim();
                var rank = (cells[1].textContent || '').trim();
                var bio = cells.length > 2 ? (cells[2].textContent || '').trim() : '';
                var avatar = cells.length > 3 ? (cells[3].textContent || '').trim() : '';
                if (!name || !rank) return;
                if (!avatar) {
                    avatar = 'https://mc-heads.net/avatar/' + encodeURIComponent(name) + '/300';
                }
                staff.push({ name: name, rank: rank, bio: bio, avatar: avatar });
            });
            return staff;
        }

        function renderStaff(staff) {
            var grid = document.getElementById('staff-grid');
            grid.innerHTML = '';
            staff.forEach(function (member) {
                var card = document.createElement('div');
                card.className = 'staff-card';
                card.setAttribute('data-rank', member.rank.toLowerCase());

                var img = document.createElement('div');
                img.className = 'staff-card-img';
                img.style.backgroundImage = 'url(' + member.avatar + ')';
                card.appendChild(img);

                var name = document.createElement('h3');
                name.className = 'staff-card-name';
                name.textContent = member.name;
                card.appendChild(name);

                var rank = document.createElement('p');
                rank.className = 'staff-card-rank';
                rank.textContent = member.rank;
                card.appendChild(rank);

                if (member.bio) {
                    var bio = document.createElement('p');
                    bio.className = 'staff-card-bio';
                    bio.textContent = member.bio;
                    card.appendChild(bio);
                }

                grid.appendChild(card);
            });
        }

        var staff = parseStaffTable();
        renderStaff(staff);

        var pills = document.querySelectorAll('.staff-pill');
        var noTableMsg = document.querySelector('.staff-empty[data-state="no-table"]');
        var noMatchMsg = document.querySelector('.staff-empty[data-state="no-match"]');

        if (noTableMsg) {
            noTableMsg.style.display = staff.length === 0 ? '' : 'none';
        }

        // Live counts on each pill, e.g. "MODS (4)", based on what actually parsed.
        pills.forEach(function (pill) {
            var rank = pill.getAttribute('data-filter');
            var count = staff.filter(function (m) { return m.rank.toLowerCase() === rank; }).length;
            pill.textContent = pill.textContent + ' (' + count + ')';
        });

        function applyFilter(rank) {
            var cards = document.querySelectorAll('.staff-card');
            var visibleCount = 0;
            cards.forEach(function (card) {
                var match = (card.getAttribute('data-rank') || '') === rank;
                card.style.display = match ? '' : 'none';
                if (match) visibleCount++;
            });
            if (noMatchMsg) {
                noMatchMsg.style.display = (staff.length > 0 && visibleCount === 0) ? '' : 'none';
            }
        }

        pills.forEach(function (pill) {
            pill.addEventListener('click', function () {
                pills.forEach(function (p) { p.classList.remove('is-active'); p.setAttribute('aria-pressed', 'false'); });
                pill.classList.add('is-active');
                pill.setAttribute('aria-pressed', 'true');
                applyFilter(pill.getAttribute('data-filter'));
            });
            pill.setAttribute('aria-pressed', pill.classList.contains('is-active') ? 'true' : 'false');
        });

        if (staff.length > 0) {
            applyFilter('owner');
        }
    })();
</script>
